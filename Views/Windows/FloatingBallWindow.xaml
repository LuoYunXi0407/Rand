<Window x:Class="rand7.Views.Windows.FloatingBallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:rand7.Views.Windows"
        mc:Ignorable="d"
        Title="FloatingBallWindow" Width="50" Height="50"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave"
        MouseDown="Window_MouseDown"
        MouseUp="Window_MouseUp"
        
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid>
        <Ellipse Width="50" Height="50" Fill="LightBlue" Stroke="Gray"
             StrokeThickness="2" Opacity="0.8"
             />
    </Grid>
</Window>
